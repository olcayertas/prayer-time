<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the widget picker (the live widget renders via Glance once placed). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="250dp"
    android:layout_height="110dp"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_bg"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Küçükçekmece"
        android:textColor="#8A93A8"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/prayer_noon"
        android:textColor="#E3B341"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="13:15"
        android:textColor="#EDEFF7"
        android:textSize="16sp" />
</LinearLayout>
