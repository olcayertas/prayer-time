require "shellwords"

# xcodebuild's output passes through Ruby strings (fastlane, xcpretty). Ruby takes its default
# encoding from the locale when the process starts, so a shell without a UTF-8 LANG makes it
# US-ASCII and the archive dies on the first non-ASCII byte in the build log. Force UTF-8 here, for
# this process and for the tools it starts (same fix as sarp-mobil's Fastfile).
Encoding.default_external = Encoding::UTF_8
ENV["LANG"] = "en_US.UTF-8" if ENV["LANG"].to_s.empty?
ENV["LC_ALL"] = "en_US.UTF-8" if ENV["LC_ALL"].to_s.empty?

default_platform(:ios)

APP_ID = "com.olcayertas.NamazVakti.iOS"
TEAM_ID = "SNZ29V4PJZ"
IOS_SCHEME = "NamazVaktiiOS"
OUTPUT_DIR = "build/fastlane" # relative to apple/, where actions run (gitignored: build/)

# App Store Connect API key from the environment (never committed):
#   ASC_KEY_ID     – the 10-char Key ID (the XXXX in AuthKey_XXXX.p8)
#   ASC_ISSUER_ID  – the Issuer ID (UUID) from Users and Access → Integrations → Keys. When it is not
#                    set, it is read from the login keychain (generic password, service
#                    "ASC_ISSUER_ID"), so it never has to sit in a file or the shell history.
#   ASC_KEY_PATH   – absolute path to the AuthKey_XXXX.p8 file
# The key's role must be App Manager or Admin — a Developer-role key (e.g. one made only for
# notarization) cannot edit App Store metadata and will fail with 403s.
if ENV["ASC_ISSUER_ID"].to_s.strip.empty?
  issuer = `security find-generic-password -s ASC_ISSUER_ID -w 2>/dev/null`.strip
  ENV["ASC_ISSUER_ID"] = issuer unless issuer.empty?
end

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "Archive NamazVaktiiOS (Release), export for App Store Connect, upload to TestFlight (internal), wait for processing."
  desc "Options: build_number:<n> (default: latest TestFlight build number + 1). Does NOT submit for review."
  lane :beta do |options|
    api_key = asc_api_key
    sh("cd .. && xcodegen generate") # the .xcodeproj is generated (gitignored); lanes run in fastlane/

    number = (options[:build_number] || latest_testflight_build_number(
      api_key: api_key, app_identifier: APP_ID, initial_build_number: 0
    ).to_i + 1).to_s
    UI.important("Build number #{number}")

    # Signing uses the Xcode-signed-in account (automatic, -allowProvisioningUpdates), never the API
    # key: an -authenticationKey* export failed with a cloud-signing permission error (sarp-mobil,
    # 2026-09-27). The key is only for the App Store Connect calls.
    build_app(
      project: "NamazVakti.xcodeproj",
      scheme: IOS_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: "Distribution/ExportOptions-AppStore.plist",
      skip_profile_detection: true, # else a detected profile mapping forces signingStyle=manual
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{number.shellescape}",
      archive_path: "#{OUTPUT_DIR}/NamazVaktiiOS.xcarchive",
      output_directory: OUTPUT_DIR,
      output_name: "NamazVaktiiOS.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_ID,
      changelog: File.read("metadata/en-US/release_notes.txt").strip, # TestFlight "What to Test"
      skip_waiting_for_build_processing: false,
      distribute_external: false
    )
    UI.success("Uploaded #{APP_ID} build #{number}; processing finished")
  end

  desc "Push App Store listing metadata + screenshots (no binary; the build comes from the beta lane). Does NOT submit."
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,        # the .ipa is uploaded by `fastlane ios beta`, not here
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,        # review + submit stays a manual, deliberate step
      automatic_release: false,
      force: true,                     # non-interactive: skip the HTML metadata preview prompt
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Delete ALL screenshots on the editable version (both locales) — used to clear duplicate uploads."
  lane :clear_screenshots do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_PATH")))
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    app.get_app_store_versions.select { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }.each do |v|
      v.get_app_store_version_localizations.each do |l|
        (l.get_app_screenshot_sets rescue []).each do |s|
          (s.app_screenshots || []).each do |sc|
            sc.delete!
            UI.message("deleted #{l.locale} screenshot #{sc.id}")
          end
        end
      end
    end
    UI.success("cleared all screenshots")
  end

  desc "Delete duplicate screenshots (deliver double-uploads 1320x2868 into APP_IPHONE_67); keep one per file name."
  lane :dedupe_screenshots do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_PATH")))
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    app.get_app_store_versions.select { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }.each do |v|
      v.get_app_store_version_localizations.each do |l|
        (l.get_app_screenshot_sets rescue []).each do |s|
          seen = {}
          (s.app_screenshots || []).each do |sc|
            key = sc.file_name || sc.id   # nil name → treat as unique (never collapse)
            if seen[key]
              sc.delete!
              UI.message("#{l.locale}: deleted duplicate #{key}")
            else
              seen[key] = true
              UI.message("#{l.locale}: kept #{key}")
            end
          end
        end
      end
    end
    UI.success("dedupe complete")
  end

  desc "Diagnostic: print the app's primary locale + each version's localizations (what's actually on App Store Connect)."
  lane :inspect do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_PATH"))
    )
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.important("APP: #{app.name.inspect} id=#{app.id} primaryLocale=#{app.primary_locale}")
    app.get_app_store_versions.each do |v|
      UI.important("VERSION #{v.version_string} state=#{v.app_store_state}")
      v.get_app_store_version_localizations.each do |l|
        UI.message("  locale=#{l.locale}  desc?=#{!l.description.to_s.empty?}  keywords?=#{!l.keywords.to_s.empty?}")
        (l.get_app_screenshot_sets rescue []).each do |s|
          UI.message("      set #{s.screenshot_display_type}: #{(s.app_screenshots || []).size} shots")
        end
      end
    end
  end
end

MAC_APP_ID = "com.olcayertas.NamazVakti"

platform :mac do
  desc "Push App Store metadata + screenshots for Namaz Vakti for Mac (no binary; the build comes from Xcode Cloud). Does NOT submit."
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: MAC_APP_ID,
      platform: "osx",
      metadata_path: "./fastlane/metadata-mac",
      screenshots_path: "./fastlane/screenshots-mac",
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Diagnostic: the macOS app's locales + screenshot counts per set."
  lane :inspect do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_PATH")))
    app = Spaceship::ConnectAPI::App.find(MAC_APP_ID)
    UI.important("APP: #{app.name.inspect} id=#{app.id}")
    app.get_app_store_versions.each do |v|
      UI.important("VERSION #{v.version_string} state=#{v.app_store_state}")
      v.get_app_store_version_localizations.each do |l|
        UI.message("  locale=#{l.locale}  desc?=#{!l.description.to_s.empty?}")
        (l.get_app_screenshot_sets rescue []).each do |s|
          UI.message("      set #{s.screenshot_display_type}: #{(s.app_screenshots || []).size} shots")
        end
      end
    end
  end

  desc "Delete duplicate macOS screenshots (deliver double-uploads); keep one per file name."
  lane :dedupe_screenshots do
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      filepath: File.absolute_path(ENV.fetch("ASC_KEY_PATH")))
    app = Spaceship::ConnectAPI::App.find(MAC_APP_ID)
    app.get_app_store_versions.select { |v| v.app_store_state == "PREPARE_FOR_SUBMISSION" }.each do |v|
      v.get_app_store_version_localizations.each do |l|
        (l.get_app_screenshot_sets rescue []).each do |s|
          seen = {}
          (s.app_screenshots || []).each do |sc|
            key = sc.file_name || sc.id
            if seen[key]
              sc.delete!
              UI.message("#{l.locale}: deleted duplicate #{key}")
            else
              seen[key] = true
            end
          end
        end
      end
    end
    UI.success("dedupe complete")
  end
end
